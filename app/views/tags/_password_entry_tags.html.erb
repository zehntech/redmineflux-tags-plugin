<%# rtg-010: tags of the Redmineflux Password Manager's entries (shared tags/taggings tables, its rfpm-026).
    Rendered only when that plugin is installed; while it is not compatible, a warning replaces the list. %>
<% password_tags_problem = FluxTags::PasswordTags.problem %>
<% if password_tags_problem %>
  <p class="warning">
    <%= l("text_flux_tags_pm_#{password_tags_problem}", details: FluxTags::SharedTagsSchema.problem) %>
  </p>
<% else %>
<% password_tags = FluxTags::PasswordTags.available_tags.to_a %>
<% @password_entry_tags = WillPaginate::Collection.create(params[:password_entry_page] || 1, params[:per_page] || 10, password_tags.size) do |pager| %>
  <% pager.replace(password_tags[pager.offset, pager.per_page] || []) %>
<% end %>
 <%=  javascript_include_tag('tags.js', :plugin => :flux_tags) %>

<% if @password_entry_tags.present? %>
  <table class="list issues">
    <thead>
      <tr>
        <th class="checkbox hide-when-print">
          <%= link_to '#',
          id: 'toggle-checkbox-password',
                onclick: 'tagsCheckboxPassword(event); return false;',
                title: "#{ l :button_check_all }/#{ l :button_uncheck_all }" do %>
            <%= rf_toggle_check_icon %>
          <% end %>
        </th>
        <th><%= l(:field_name) %></th>
        <th align="center" style="width:10%;"></th>
      </tr>
    </thead>
    <tbody>
      <% @password_entry_tags.each do |tag| %>
        <tr class="hascontextmenu <%= cycle('odd', 'even') %>" style="height:30px">
          <td class="checkbox hide-when-print">
            <%= check_box_tag 'tag_ids[]', tag.id, false, id: "password_tag_#{tag.id}", class: 'checkbox_toggle_selection checkbox_toggle_selection_password' %>
          </td>
          <td><%= render_tag_link(tag) %></td>
          <td class="buttons">
            <%= rf_icon_link(
              :edit,
              l(:button_edit),
              edit_tag_path(tag, tab: FluxTags::PasswordTags::TAB),
              class: 'edit-tag icon-edit-password',
              data: { tag_id: tag.id }
            ) %>
            <%= rf_icon_link(
              :delete,
              l(:label_delete),
              'javascript:void(0);',
              class: 'icon-del-password',
              onclick: "showCustomConfirm(#{tag.id},'#{FluxTags::PasswordTags::TAB}'); return false;"
            ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @password_entry_tags.total_pages > 1 %>
    <div class="pagination">
      <%= will_paginate @password_entry_tags, renderer: CustomWillPaginateRenderer, param_name: 'password_entry_page', params: { tab: FluxTags::PasswordTags::TAB } %>
    </div>
  <% else %>
    <span class="items">
      (<%= (@password_entry_tags.current_page - 1) * @password_entry_tags.per_page + 1 %>-<%= (@password_entry_tags.current_page - 1) * @password_entry_tags.per_page + @password_entry_tags.length %>/<%= @password_entry_tags.total_entries %>)
    </span>
    <span class="per-page">
      <%= l(:label_for_pages)%>
      <% [10, 20, 50].each do |per_page_option| %>
        <%= per_page_option == params[:per_page].to_i ? content_tag(:span, per_page_option, class: 'selected', style: 'font-weight:bold;') : link_to(per_page_option.to_s, { per_page: per_page_option, tab: FluxTags::PasswordTags::TAB }) %>
        <%= ',' unless per_page_option == 50 %>
      <% end %>
    </span>
  <% end %>
  <br>
<% else %>
  <p class="nodata"><%= l :label_no_data %></p>
<% end %>
<% end %>
