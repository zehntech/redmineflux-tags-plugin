 <%=  javascript_include_tag('tags.js', :plugin => :flux_tags) %>


<% @project_tags = WillPaginate::Collection.create(params[:project_page] || 1, params[:per_page] || 10, Project.available_tags.to_a.size) do |pager| %>
  <% pager.replace(Project.available_tags.to_a[pager.offset, pager.per_page]) %>
<% end %>

<% if @project_tags.present? %>
  <div class="rtg-table-section">
    <div class="rtg-table-container">
      <table class="rtg-table">
        <thead>
          <tr>
            <th class="rtg-col-checkbox hide-when-print">
              <%= link_to '#',
              id: 'toggle-checkbox-project',
                    onclick: 'tagsCheckboxProject(event); return false;',
                    title: "#{ l :button_check_all }/#{ l :button_uncheck_all }" do %>
                <%= rf_toggle_check_icon %>
              <% end %>
            </th>
            <th><%= l(:field_name) %></th>
            <th class="rtg-col-actions"></th>
          </tr>
        </thead>
        <tbody>
          <% @project_tags.each_with_index do |tag, index| %>
            <tr class="hascontextmenu">
              <td class="rtg-col-checkbox hide-when-print">
                <%= check_box_tag 'tag_ids[]', tag.id, false, id: "tag_#{tag.id}", class: 'checkbox_toggle_selection_project checkbox_toggle_selection', id: 'toggle-checkbox' %>
              </td>
              <td><%= render_tag_link(tag) %></td>
              <td class="rtg-col-actions">
                <div class="rtg-action-buttons">
                  <%= rf_icon_link(
                    :edit,
                    l(:button_edit),
                    edit_tag_path(tag, tab: 'project'),
                    class: 'icon-edit-project rtg-action-icon rtg-edit-icon'
                  ) %>
                  <%= rf_icon_link(
                    :delete,
                    l(:label_delete),
                    'javascript:void(0);',
                    class: 'icon-del-project rtg-action-icon rtg-delete-icon',
                    onclick: "showCustomConfirm(#{tag.id},'project'); return false;"
                  ) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @project_tags.total_pages > 1 %>
      <div class="rtg-pagination">
        <%= will_paginate @project_tags,renderer: CustomWillPaginateRenderer, param_name: 'project_page', params: { tab: 'project' } %>
      </div>
      <%else%>
      <div class="rtg-pagination">
        <span class="items">
          (<%= (@project_tags.current_page - 1) * @project_tags.per_page + 1 %>-<%= (@project_tags.current_page - 1) * @project_tags.per_page + @project_tags.length %>/<%= @project_tags.total_entries %>)
        </span>
        <span class="per-page">
          <%= l(:label_for_pages)%>
          <% [10, 20, 50].each do |per_page_option| %>
            <%= per_page_option == params[:per_page].to_i ? content_tag(:span, per_page_option, class: 'selected', style: 'font-weight:bold;') : link_to(per_page_option.to_s, { per_page: per_page_option, tab: 'project' }) %>
            <%= ',' unless per_page_option == 50 %>
          <% end %>
        </span>
      </div>
    <%end%>
  </div>
<% else %>
  <div class="rtg-empty-state">
    <h3><%= l :label_no_data %></h3>
  </div>
<% end %>
