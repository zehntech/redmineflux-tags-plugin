<%# Kept for old links: renaming a tag now happens on the Tags page of the plugin settings. %>
<%= stylesheet_link_tag 'rf_flux_tags', plugin: :flux_tags %>
<h2>
  <%= h l(:issue_tags_tag) + ': ' + @tag.name %>
</h2>
<%= form_tag tag_path(@tag, tab: params[:tab]), class: 'tabular', method: :put do %>
  <%= error_messages_for 'tag' %>
  <div class="box">
    <p>
      <label for="tag_name"><%= l(:tag_name) %></label>
      <%= text_field_tag 'tag[name]', @tag.name, id: 'tag_name', maxlength: RfFluxTags::TAG_NAME_MAX %>
    </p>
  </div>
  <%= submit_tag l(:button_save) %>
  <%= link_to l(:button_cancel), controller: 'settings', action: 'plugin',
        id: 'flux_tags', tab: params[:tab] %>
<% end %>
